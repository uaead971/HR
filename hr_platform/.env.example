# Copy this file to .env only for local deployment configuration.
# Never commit .env or place real credentials in source control.

# Required when HR_ENV=production. Generate a unique value with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HR_ENV=development
HR_SECRET_KEY=replace-with-a-unique-random-value-at-least-32-characters

# Production server settings (the container start script uses PORT when a
# hosting provider supplies it).
HR_HOST=0.0.0.0
HR_PORT=8765
HR_DB_PATH=/var/data/hr.sqlite3

# Required only for the first start of a new production database. Remove the
# password from the hosting provider after the first successful login.
HR_BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
HR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
HR_BOOTSTRAP_ADMIN_NAME=System Administrator
